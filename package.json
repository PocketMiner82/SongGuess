{
  "name": "songguess",
  "version": "3.3.1-dev.3",
  "type": "module",
  "private": true,
  "scripts": {
    "postinstall": "npm run typegen",
    "dev": "wrangler dev --env localdev",
    "deploy": "wrangler deploy",
    "deploy:dev": "wrangler deploy --env dev",
    "clean": "rm -rf public/dist",
    "build": "node build-html.js && postcss ./src/client/global.css -o ./public/dist/global.css && esbuild src/client/*.tsx --bundle --splitting --format=esm --platform=browser --outdir=public/dist --define:process.env.NODE_ENV=\\\"production\\\" --minify",
    "build:localdev": "node build-html.js && postcss ./src/client/global.css -o ./public/dist/global.css && esbuild src/client/*.tsx --bundle --splitting --format=esm --platform=browser --outdir=public/dist",
    "typegen": "wrangler types ./src/server/worker-configuration.d.ts --env-file .env.example",
    "check": "tsc && eslint src/ && wrangler deploy --dry-run",
    "docs:generate": "typedoc",
    "docs:serve": "typedoc --watch"
  },
  "dependencies": {
    "@syncfm/applemusic-api": "^0.0.6",
    "@types/hls.js": "^1.0.0",
    "chroma-js": "^3.2.0",
    "cookie": "^2.0.1",
    "fuzzball": "^2.2.6",
    "hls.js": "^1.7.3",
    "howler": "^2.2.4",
    "itunes-store-api": "^2.1.0",
    "lodash": "^4.18.1",
    "papaparse": "^5.7.0",
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0",
    "react": "^19.3.0",
    "react-cookie": "^8.1.2",
    "react-cookie-consent": "^10.0.2",
    "react-dom": "^19.3.0",
    "react-modal-global": "^2.3.7",
    "react-toastify": "^11.1.0",
    "soundcloud.ts": "^0.7.4",
    "unique-username-generator": "^1.5.1",
    "uuid": "^14.0.2",
    "youtubei.js": "^18.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@eslint-react/eslint-plugin": "^5.20.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/chroma-js": "^3.1.2",
    "@types/howler": "^2.2.13",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.6.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.61.0",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "postcss": "^8.5.28",
    "postcss-cli": "^12.0.0",
    "tailwindcss": "^4.3.1",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "wrangler": "^4.136.2"
  }
}
